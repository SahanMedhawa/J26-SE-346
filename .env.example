# Copy this file to .env and fill in your values if overriding the default local database.
# .env is ignored by Git to keep passwords secure.

# Optional: Neon or custom PostgreSQL for Rules module (defaults to internal timescaledb container if omitted)
# AKEGP_RULES_DB_URL=jdbc:postgresql://<host>:5432/<dbname>?sslmode=require
# AKEGP_RULES_DB_USER=<username>
# AKEGP_RULES_DB_PASSWORD=<password>

# Optional: GitHub token for repository file browsing
# AKEGP_GITHUB_TOKEN=<personal_access_token>
